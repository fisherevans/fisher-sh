{
  "_comment": "Edit via editor.py (Settings tab). build.py renders this into dist/theme.css which is linked after style.css so these tokens override the defaults baked into the stylesheet.",
  "colors": {
    "bg": "#1c1a17",
    "fg": "#e8dec8",
    "muted": "#7a716a",
    "accent": "#e89b4b",
    "hover": "#1c1a17",
    "hover-bg": "#e57806",
    "divider": "#7a716a"
  },
  "sizes": {
    "font-size-base-px": 24,
    "font-size-h1-rem": 4,
    "font-size-h2-rem": 1.5,
    "max-width-px": 900,
    "line-height-body": 1.25
  },
  "marauder": {
    "opsz-body": 14,
    "opsz-h1": 72,
    "opsz-h2": 20,
    "weight-body": 500,
    "weight-h1": 800,
    "weight-h2": 700,
    "weight-link": 450
  },
  "bullets": {
    "glyph": "\u203a",
    "projects-glyph": "\u203a",
    "size-em": 1,
    "offset-x-em": 0.18,
    "offset-y-em": 0
  }
}
